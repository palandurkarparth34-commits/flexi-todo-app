PORT=5000
NODE_ENV=development
# Replace with your MongoDB connection string (Local or MongoDB Atlas)
# Example for Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/todo-app?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/todo-app
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
